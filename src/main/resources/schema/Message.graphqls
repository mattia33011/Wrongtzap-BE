extend type Query{
    Message(messageId: Float!): Message!
    searchMessage(messageBody: String!): [Message!]
    everyMessage: [Message!]
}

type Message{
    messageId: Float!
    timestamp: Float!
    content: String!
    username: String!
    userId: Float!
    associatedChat: Float!
    deletedForUser: [String]!
}

type MessageResponse{
    username: String!
    userId: Float!
    content: String!
    timestamp: Float!
}

