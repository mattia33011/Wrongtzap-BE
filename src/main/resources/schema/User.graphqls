scalar Long

type Query{
    user(userId: String!): User!
    everyUser: [User!]
}


type User {
    userId: String!
    username: String!
    chats: PagedChats!
    groups: PagedGroups!
    friends: [FriendResponse!]
}


type UserProfile{
    userId: String!
    username: String!
}


type FriendResponse{
    friendshipId: String!
    userId: String!
    username: String!
    status: String!
}





